@startuml
title MarketFlow - Current Modular Monolith

skinparam componentStyle rectangle
skinparam shadowing false

actor Buyer
actor Seller

rectangle "MarketFlow Spring Boot Application" {
  component "Buyer MVC Controllers" as BuyerControllers
  component "Seller MVC Controllers" as SellerControllers
  component "Application Services" as Services
  component "Spring Data JPA Repositories" as Repositories
  component "Thymeleaf Views" as Views
  component "Flyway" as Flyway
  component "Actuator" as Actuator
}

database "PostgreSQL" as PostgreSQL

Buyer --> BuyerControllers
Seller --> SellerControllers
BuyerControllers --> Services
SellerControllers --> Services
Services --> Repositories
Repositories --> PostgreSQL
BuyerControllers --> Views
SellerControllers --> Views
Flyway --> PostgreSQL : schema migrations
Actuator --> PostgreSQL : health check

@enduml
